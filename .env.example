# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Comma-separated list of allowed Telegram user IDs (e.g. 123456789,987654321)
# Obtain your ID by messaging @userinfobot or @raw_data_bot
AUTHORIZED_TELEGRAM_USER_IDS=123456789

# ==============================================================================
# Instagram Integration Configuration
# ==============================================================================
# The Instagram username of the account you own/control
INSTAGRAM_ACCOUNT=my_personal_account

# Instagram authentication method:
# - graph_api: Uses Meta Graph API (Standard for Professional/Creator accounts)
# - oembed: Uses Meta oEmbed API for public links
# - webhook: Listens for Instagram Direct Message webhooks
# - mock: Used for testing and simulation
INSTAGRAM_AUTH_METHOD=graph_api

# Meta Graph API User/Page Access Token (Requires instagram_basic, instagram_manage_messages)
INSTAGRAM_ACCESS_TOKEN=EAAB...

# Meta App Secret (used to verify incoming webhook signatures)
INSTAGRAM_APP_SECRET=

# Secret token configured in Meta App Dashboard for webhook challenge verification
INSTAGRAM_VERIFY_TOKEN=my_secure_webhook_verify_token_123

# ==============================================================================
# Storage & Database Configuration
# ==============================================================================
# SQLite database path (inside persistent data directory)
DATABASE_URL=sqlite:///data/bot.db

# Directory for temporary media downloads
DOWNLOAD_DIR=./downloads

# Keep downloaded media permanently instead of deleting after Telegram delivery (default: false)
KEEP_DOWNLOADS=false

# Maximum allowed file size for media download and Telegram delivery in bytes (50MB = 52428800)
MAX_DOWNLOAD_SIZE_BYTES=52428800

# ==============================================================================
# Pipeline & Network Settings
# ==============================================================================
# Max retry attempts for transient network issues
MAX_RETRIES=3

# Initial retry backoff in seconds (exponential backoff 2s, 4s, 8s)
RETRY_BACKOFF_SECONDS=2.0

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30.0

# Polling interval in seconds
POLL_INTERVAL_SECONDS=2.0

# Webhook server configuration (for receiving Instagram DM webhooks)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
